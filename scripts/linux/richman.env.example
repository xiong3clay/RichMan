# RichMan 运行配置（systemd EnvironmentFile，root:richman 0640）
# 改完执行：systemctl restart richman

# 监听端口（云服务器需在安全组放行 TCP 8000）
PORT=8000

# 存档、日志、备份目录（必须是绝对路径，且属主为 richman）
RICHMAN_DATA_DIR=/var/lib/richman

# 前端静态目录（安装时按包内 app/web/dist 生成）
RICHMAN_STATIC_DIR=/opt/richman/app/web/dist

# 可选安全限额（缺省 200 连接 / 每 IP 20 / 50 房间）
# RICHMAN_MAX_CONNECTIONS=200
# RICHMAN_MAX_CONNECTIONS_PER_IP=20
# RICHMAN_MAX_ROOMS=50

# 可选：反向代理场景的 Origin 白名单，逗号分隔
# RICHMAN_ALLOWED_ORIGINS=https://richman.example.com

# 可选：仅当确实在可信反向代理后面才设为 1（影响客户端 IP 识别）
# RICHMAN_TRUST_PROXY=1
